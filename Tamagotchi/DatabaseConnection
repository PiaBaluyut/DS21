    // --- CREATE MESSAGE ---
    public static void createMessage(Connection conn, int petId,
            String messageText, String messageType)
            throws SQLException {

        String sql =
                "INSERT INTO MESSAGES "
                + "(pet_id, message_text, message_type) "
                + "VALUES (?, ?, ?)";

        try (PreparedStatement pstmt = conn.prepareStatement(sql)) {

            pstmt.setInt(1, petId);
            pstmt.setString(2, messageText);
            pstmt.setString(3, messageType);

            pstmt.executeUpdate();

            System.out.println("[MESSAGE] Message saved.");
