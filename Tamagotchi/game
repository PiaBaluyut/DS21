package com.mycompany.finals;

import javax.swing.*;
import java.awt.*;
import java.awt.event.ActionEvent;
import java.awt.event.ActionListener;

public class Game extends JFrame {
    private Creature creature;
    
    // UI Components
    private JLabel statusLabel;
    private JTextArea logTextArea;
    private JButton playButton, eatButton, sleepButton, quitButton;

    public Game() {
        setTitle("Javagotchi - Tamagotchi Game");
        setSize(450, 400);
        setDefaultCloseOperation(JFrame.EXIT_ON_CLOSE);
        setLocationRelativeTo(null); // Center on screen
        setLayout(new BorderLayout(10, 10));

        // 1. Setup Tutorial / Initialization via Dialogs
        String[] speciesOptions = {"Cat", "Dog", "Pig"};
        int speciesChoice = JOptionPane.showOptionDialog(
            this,
            "What kind of animal would you like?",
            "Choose Species",
            JOptionPane.DEFAULT_OPTION,
            JOptionPane.QUESTION_MESSAGE,
            null,
            speciesOptions,
            speciesOptions[0]
        );

        String species = (speciesChoice >= 0) ? speciesOptions[speciesChoice] : "Cat";
        
        String name = JOptionPane.showInputDialog(
            this, 
            "What's the name of your " + species.toLowerCase() + "?", 
            "Name Your Creature", 
            JOptionPane.QUESTION_MESSAGE
        );

        if (name == null || name.trim().isEmpty()) {
            name = "Javagotchi";
        }

        // Initialize Creature
        creature = new Creature(name, species);

        // --- TOP PANEL: Status ---
        statusLabel = new JLabel(creature.Status(), JLabel.CENTER);
        statusLabel.setFont(new Font("Arial", Font.BOLD, 14));
        statusLabel.setBorder(BorderFactory.createEmptyBorder(10, 10, 10, 10));
        add(statusLabel, BorderLayout.NORTH);

        // --- CENTER PANEL: Log/Message Area ---
        logTextArea = new JTextArea("Welcome to Javagotchi! Meet " + creature.getName() + " the " + species + "!\n");
        logTextArea.setEditable(false);
        logTextArea.setFont(new Font("Monospaced", Font.PLAIN, 12));
        JScrollPane scrollPane = new JScrollPane(logTextArea);
        scrollPane.setBorder(BorderFactory.createTitledBorder("Game Log"));
        add(scrollPane, BorderLayout.CENTER);

        // --- BOTTOM PANEL: Action Buttons ---
        JPanel buttonPanel = new JPanel(new GridLayout(2, 2, 8, 8));
        buttonPanel.setBorder(BorderFactory.createEmptyBorder(10, 10, 10, 10));

        playButton = new JButton("Play");
        eatButton = new JButton("Eat");
        sleepButton = new JButton("Sleep");
        quitButton = new JButton("Quit");

        buttonPanel.add(playButton);
        buttonPanel.add(eatButton);
        buttonPanel.add(sleepButton);
        buttonPanel.add(quitButton);

        add(buttonPanel, BorderLayout.SOUTH);

        // --- BUTTON LISTENERS ---
        playButton.addActionListener(e -> handleAction(1));
        eatButton.addActionListener(e -> handleAction(2));
        sleepButton.addActionListener(e -> handleAction(3));
        quitButton.addActionListener(e -> handleAction(4));
    }

    private void handleAction(int choice) {
    if (creature.isDead()) {
        return; // Do nothing if already dead
    }

    String message = "";
    switch (choice) {
        case 1:
            creature.play();
            message = creature.getName() + " had fun playing!";
            break;
        case 2:
            creature.eat();
            message = creature.getName() + " enjoyed a delicious meal!";
            break;
        case 3:
            creature.sleep();
            message = creature.getName() + " took a nice cozy nap.";
            break;
        case 4:
            JOptionPane.showMessageDialog(this, "Awh. Time to put " + creature.getName() + " to sleep :(");
            System.exit(0);
            break;
    }

    // Append action log & update status
    logTextArea.append(message + "\n");
    statusLabel.setText(creature.Status());

    // --- CHECK IF CREATURE DIED ---
    if (creature.isDead()) {
        String deathMsg = creature.getDeathReason();
        logTextArea.append("\n[R.I.P.] " + deathMsg + "\n");
        
        // Show a popup notification
        JOptionPane.showMessageDialog(this, deathMsg, "Game Over", JOptionPane.ERROR_MESSAGE);
        
        // Disable action buttons so the user can't keep playing
        playButton.setEnabled(false);
        eatButton.setEnabled(false);
        sleepButton.setEnabled(false);
        
        // Optionally change quit button to "Exit"
        quitButton.setText("Your pet is dead");
    }
        logTextArea.setCaretPosition(logTextArea.getDocument().getLength()); // auto-scroll
        statusLabel.setText(creature.Status());
}

        // Update UI Text
        
}
