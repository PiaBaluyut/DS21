
package com.mycompany.finals;

import javax.swing.*;
import java.awt.*;
import java.sql.Connection;
import java.sql.SQLException;
import java.sql.Connection;
import java.sql.SQLException;
import java.awt.event.WindowAdapter;
import java.awt.event.WindowEvent;

public class Game extends JFrame {
    private Creature creature;

    // UI Components
    private JLabel statusLabel;
    private JLabel petImageLabel;
    private JTextArea logTextArea;
    private JButton playButton, eatButton, sleepButton, quitButton;
    private Connection conn;
    private int petId;

    public Game() {
        setTitle("Javagotchi - Tamagotchi Game");
        setSize(500, 600);
        setDefaultCloseOperation(JFrame.DO_NOTHING_ON_CLOSE);

addWindowListener(new WindowAdapter() {
    @Override
    public void windowClosing(WindowEvent e) {
        try {
            if (conn != null && !conn.isClosed()) {
                conn.close();
            }
        } catch (SQLException ex) {
            ex.printStackTrace();
        }

        dispose();
        System.exit(0);
    }
});
        setLocationRelativeTo(null);
        setLayout(new BorderLayout(10, 10));

        // Choose Species
        String[] speciesOptions = {"Cat", "Dog", "Fox"};

        int speciesChoice = JOptionPane.showOptionDialog(
            this,
            "What kind of animal would you like?",
            "Choose Species",
            JOptionPane.DEFAULT_OPTION,
            JOptionPane.QUESTION_MESSAGE,
            null,
            speciesOptions,
            speciesOptions[0]
        );

        String species = (speciesChoice >= 0)
                ? speciesOptions[speciesChoice] : "Cat";

        String name = JOptionPane.showInputDialog(
            this,
            "What's the name of your " + species.toLowerCase() + "?",
            "Name Your Creature",
            JOptionPane.QUESTION_MESSAGE
        );

        if (name == null || name.trim().isEmpty()) {
            name = "Javagotchi";
        }

        // Connect to database
try {

    conn = DatabaseConnection.connect();

    // Search for an existing pet using its name
    petId = DatabaseConnection.searchCreature(conn, name);

    if (petId != -1) {

        // Load existing pet
        creature = DatabaseConnection.loadCreature(conn, petId);

        JOptionPane.showMessageDialog(
                this,
                "Welcome back! " + creature.getName()
                + " has been loaded!"
        );

        // Handle a pet that was already dead when loaded
        if (creature.isDead()) {

            DatabaseConnection.deleteCreature(conn, petId);

            JOptionPane.showMessageDialog(
                    this,
                    creature.getName()
                    + " has already passed away. "
                    + "Its records have been deleted."
            );

            // Start a new pet with the same name
            creature = new Creature(name, species);

            petId = DatabaseConnection.createCreature(
                    conn, name, species
            );
        }

    } else {

        // Create a new pet if no matching name exists
        creature = new Creature(name, species);

        petId = DatabaseConnection.createCreature(
                conn, name, species
        );

        JOptionPane.showMessageDialog(
                this,
                "A new pet named " + name + " has been created!"
        );
    }

} catch (SQLException e) {

    JOptionPane.showMessageDialog(
            this,
            "Database Error: " + e.getMessage(),
            "Error",
            JOptionPane.ERROR_MESSAGE
    );

    System.exit(1);
}

        // TOP PANEL: Status
        statusLabel = new JLabel(creature.Status(), JLabel.CENTER);
        statusLabel.setFont(new Font("Arial", Font.BOLD, 14));
        statusLabel.setBorder(
            BorderFactory.createEmptyBorder(10, 10, 10, 10)
        );

        add(statusLabel, BorderLayout.NORTH);

        // CENTER PANEL: Pet Image and Game Log
        JPanel centerPanel = new JPanel(new BorderLayout(5, 5));

        // Pet Image Display
        petImageLabel = new JLabel();
        petImageLabel.setHorizontalAlignment(JLabel.CENTER);
        petImageLabel.setVerticalAlignment(JLabel.CENTER);
        petImageLabel.setPreferredSize(new Dimension(300, 300));

        centerPanel.add(petImageLabel, BorderLayout.CENTER);

        // Game Log
        logTextArea = new JTextArea(
            "Welcome to Javagotchi! Meet " + creature.getName()
            + " the " + species + "!\n"
        );

        logTextArea.setEditable(false);
        logTextArea.setFont(new Font("Monospaced", Font.PLAIN, 12));

        JScrollPane scrollPane = new JScrollPane(logTextArea);
        scrollPane.setBorder(
            BorderFactory.createTitledBorder("Game Log")
        );
        scrollPane.setPreferredSize(new Dimension(450, 110));

        centerPanel.add(scrollPane, BorderLayout.SOUTH);

        add(centerPanel, BorderLayout.CENTER);

        // BOTTOM PANEL: Action Buttons
        JPanel buttonPanel = new JPanel(new GridLayout(2, 2, 8, 8));

        buttonPanel.setBorder(
            BorderFactory.createEmptyBorder(10, 10, 10, 10)
        );

        playButton = new JButton("Play");
        eatButton = new JButton("Eat");
        sleepButton = new JButton("Sleep");
        quitButton = new JButton("Quit");

        buttonPanel.add(playButton);
        buttonPanel.add(eatButton);
        buttonPanel.add(sleepButton);
        buttonPanel.add(quitButton);

        add(buttonPanel, BorderLayout.SOUTH);

        // BUTTON LISTENERS
        playButton.addActionListener(e -> handleAction(1));
        eatButton.addActionListener(e -> handleAction(2));
        sleepButton.addActionListener(e -> handleAction(3));
        quitButton.addActionListener(e -> handleAction(4));

        // Show Initial Pet Image
        updatePetImage(0);
    }

    // Update Pet Image Based on Expression
    private void updatePetImage(int lastAction) {

        String expression;

        // Check the pet's current condition
        if (creature.getEnergy() <= 4) {
            expression = "sleepy";

        } else if (creature.getHunger() <= 4) {
            expression = "hungry";

        } else if (creature.getHappiness() <= 4) {
            expression = "sad";

        } else if (lastAction == 3) {
            expression = "sleepy";

        } else {
            expression = "happy";
        }

        // Get Selected Animal
        String animal = creature.getSpecies();

        // Find Correct Image
        String imagePath = "/images/" + animal + "_" + expression + ".jpg";

        java.net.URL imageURL = getClass().getResource(imagePath);

        if (imageURL != null) {

            ImageIcon originalIcon = new ImageIcon(imageURL);

            Image scaledImage = originalIcon.getImage().getScaledInstance(
                250, 250, Image.SCALE_SMOOTH
            );

            petImageLabel.setIcon(new ImageIcon(scaledImage));
            petImageLabel.setText("");

        } else {

            petImageLabel.setIcon(null);
            petImageLabel.setText(
                "Image not found: " + imagePath
            );
        }
    }

    
private void handleAction(int choice) {

    if (creature.isDead()) {
        return;
    }

    String message = "";
    String activityType = "";

    switch (choice) {

        case 1:
            creature.play();
            message = creature.getName() + " had fun playing!";
            activityType = "PLAY";
            break;

        case 2:
            creature.eat();
            message = creature.getName()
                    + " enjoyed a delicious meal!";
            activityType = "EAT";
            break;

        case 3:
            creature.sleep();
            message = creature.getName()
                    + " took a nice cozy nap.";
            activityType = "SLEEP";
            break;

        case 4:

    JOptionPane.showMessageDialog(
        this,
        "Awh. Time to put " + creature.getName()
        + " to sleep :("
    );

    try {
        if (conn != null && !conn.isClosed()) {
            conn.close();
        }
    } catch (SQLException e) {
        e.printStackTrace();
    }

    dispose();
    System.exit(0);
    return;
    }

    // Save updated creature stats and activity
    try {

        DatabaseConnection.updateCreature(
                conn,
                petId,
                creature.getHunger(),
                creature.getHappiness(),
                creature.getEnergy()
        );

        DatabaseConnection.createActivity(
                conn,
                petId,
                activityType
        );

        DatabaseConnection.createMessage(
                conn,
                petId,
                message,
                activityType
        );

    } catch (SQLException e) {

        JOptionPane.showMessageDialog(
                this,
                "Unable to save game data: " + e.getMessage(),
                "Database Error",
                JOptionPane.ERROR_MESSAGE
        );
    }

    // Update Game Log and Status
    logTextArea.append(message + "\n");
    statusLabel.setText(creature.Status());

    // Update Pet Expression
    updatePetImage(choice);

    // Check If Creature Died
    if (creature.isDead()) {

        String deathMsg = creature.getDeathReason();

        logTextArea.append("\n[R.I.P.] " + deathMsg + "\n");
        
        JOptionPane.showMessageDialog(
                this,
                deathMsg,
                "Game Over",
                JOptionPane.ERROR_MESSAGE
            );

            playButton.setEnabled(false);
            eatButton.setEnabled(false);
            sleepButton.setEnabled(false);

            quitButton.setText("Your pet is dead");
        
        // Save death message
        try {

    DatabaseConnection.createMessage(
            conn, petId, deathMsg, "DEATH"
    );

    DatabaseConnection.deleteCreature(conn, petId);

    System.out.println(
            "[DELETE] Dead pet and its records have been removed."
    );

} catch (SQLException e) {

    JOptionPane.showMessageDialog(
            this,
            "Unable to delete dead pet: " + e.getMessage(),
            "Database Error",
            JOptionPane.ERROR_MESSAGE
    );
            }
        }
    }
}
