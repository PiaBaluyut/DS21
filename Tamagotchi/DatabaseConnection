    // --- SEARCH PET ---
public static int searchCreature(Connection conn, String name)
        throws SQLException {

    String sql =
            "SELECT pet_id FROM PET "
            + "WHERE UPPER(name) = UPPER(?) "
            + "ORDER BY DateCreated DESC";

    try (PreparedStatement pstmt = conn.prepareStatement(sql)) {

        pstmt.setString(1, name);

        try (ResultSet rs = pstmt.executeQuery()) {

            if (rs.next()) {
                int petId = rs.getInt("pet_id");

                System.out.println("[SEARCH] Existing pet found!");
                return petId;

            } else {
                System.out.println("[SEARCH] No existing pet found.");
                return -1;
            }
        }
    }
}

// --- LOAD PET ---
public static Creature loadCreature(Connection conn, int id)
        throws SQLException {

    String sql =
            "SELECT PET.name, PET.species, "
            + "STATUS.hunger, STATUS.happiness, STATUS.energy "
            + "FROM PET "
            + "JOIN STATUS ON PET.pet_id = STATUS.pet_id "
            + "WHERE PET.pet_id = ?";

    try (PreparedStatement pstmt = conn.prepareStatement(sql)) {

        pstmt.setInt(1, id);

        try (ResultSet rs = pstmt.executeQuery()) {

            if (rs.next()) {

                System.out.println("[LOAD] Loading saved pet...");

                return new Creature(
                        rs.getString("name"),
                        rs.getString("species"),
                        rs.getInt("hunger"),
                        rs.getInt("happiness"),
                        rs.getInt("energy")
                );
            }

            return null;
        }
    }
}
}
